# === SmartTicket backend — variables d'environnement ===

PORT=3001

# Base de données (doit correspondre à database/smartticket_schema_v1.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_NAME=smartticket_v1

# Auth JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=3600s

# Environnement : development (défaut) | production | test
# En production : JWT_SECRET >= 32 caractères (valeurs d'exemple refusées) et CORS_ORIGINS obligatoire.
NODE_ENV=development

# Origines autorisées par CORS, séparées par des virgules (jamais de « * »)
CORS_ORIGINS=http://localhost:3000

# Rate limit du login/bootstrap : LIMIT requêtes par fenêtre de TTL secondes, par IP
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL=60

# === Phase 3 : invitations technicien + email ===
# URL du frontend : sert de base au lien « /invite/accept?token=… » envoyé par mail
FRONTEND_URL=http://localhost:3000
# Durée de validité d'une invitation (heures)
INVITATION_TTL_HOURS=72

# PASSWORD_RESET_TTL_MINUTES : validité du lien « mot de passe oublié » (défaut 60).
# PASSWORD_RESET_TTL_MINUTES=60

# MAIL_MODE : smtp = envoi réel | log = le lien est affiché dans la console du backend (dev).
# Si MAIL_MODE est absent : smtp quand MAIL_USER et MAIL_PASSWORD sont renseignés, sinon log.
# En production, MAIL_MODE=smtp est obligatoire.
# MAIL_MODE=log
# Gmail : activer la validation en 2 étapes puis créer un « mot de passe d'application »
# (https://myaccount.google.com/apppasswords). N'utilisez JAMAIS le mot de passe du compte.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# MAIL_SECURE=true   (défaut : true si port 465, sinon false = STARTTLS, ex. 587)
MAIL_USER=
MAIL_PASSWORD=
# MAIL_FROM=SmartTicket <votre.adresse@gmail.com>
